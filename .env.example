# ─────────────────────────────────────────────────────────────
#  centauri-obico-bridge configuration
#  Copy this file to ".env" and edit the values below.
# ─────────────────────────────────────────────────────────────

# Printer model:
#   sdcp = Elegoo Centauri Carbon (default)
#   cc2  = Elegoo Centauri Carbon 2
PRINTER_PROTOCOL=sdcp

# IP address (or hostname) of your printer. Always required.
CENTAURI_HOST=192.168.1.50

# ── Centauri Carbon (sdcp) ──
# SDCP WebSocket port and camera (MJPEG) port. Defaults are correct
# for the stock Centauri Carbon firmware.
CENTAURI_SDCP_PORT=3030
CENTAURI_VIDEO_PORT=3031

# ── Centauri Carbon 2 (cc2) ──
# Enable LAN Only Mode on the printer (Settings → Network → LAN Only Mode)
# and copy the access code shown there. Required for cc2.
#CENTAURI_ACCESS_CODE=
# Serial number; discovered automatically when empty.
#CENTAURI_SERIAL=

# Run automatic bed levelling when a print is started through Obico.
# 1 = on (recommended), 0 = off.
START_CALIBRATION=1

# URL of your Obico server.
#   Cloud:       https://app.obico.io
#   Self-hosted: http://<your-server>:3334
# Only used by ./install.sh to generate the moonraker-obico config.
OBICO_SERVER_URL=https://app.obico.io
